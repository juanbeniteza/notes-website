---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonicalURL?: URL | string;
  article?: boolean;
}
const {
  title = 'Notes | Juan Benitez',
  description = 'Notes from Juan Benitez on software, AI, and learning.',
  image,
  noindex = false,
  canonicalURL = Astro.url,
  article = false,
} = Astro.props as Props;
const socialImageURL = image ? new URL(image, Astro.site).toString() : undefined;
const permalink = canonicalURL.toString();
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={permalink} />
<meta name="description" content={description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={permalink} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImageURL && <meta property="og:image" content={socialImageURL} />}
<meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="icon" type="image/png" href="/favicon.png" />
<meta name="theme-color" content="#faf9f5" />
<title>{title}</title>
