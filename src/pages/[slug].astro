---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const today = new Date();
  const notes = (await getCollection('notes')).filter(note => !note.data.draft && note.data.pubDate <= today);
  return notes.map(note => ({ params: { slug: note.slug }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const formattedDate = note.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Layout title={`${note.data.title} | Juan Benitez`} description={note.data.description} article={true}>
  <article class="note-page">
    <a class="all-notes-link" href="/">All notes</a>
    <header class="article-header">
      <time datetime={note.data.pubDate.toISOString()}>{formattedDate}</time>
      <h1>{note.data.title}</h1>
      <p>{note.data.description}</p>
      {note.data.tags && note.data.tags.length > 0 && <ul class="tags">{note.data.tags.map(tag => <li>{tag}</li>)}</ul>}
    </header>
    <div class="article-body"><Content /></div>
    <div class="article-end"><a href="/">All notes</a></div>
  </article>
</Layout>
