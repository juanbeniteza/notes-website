---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const today = new Date();
const notes = (await getCollection('notes'))
  .filter(note => !note.data.draft && note.data.pubDate <= today)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout title="Notes | Juan Benitez" description="Notes from Juan Benitez on software, AI, and what he is learning along the way.">
  <div class:list={['notes-home', notes.length === 0 && 'notes-home-empty']}>
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> WRITING BY JUAN BENITEZ</p>
      <h1 id="page-title">Notes<span>.</span></h1>
      <p class="intro-copy">A place for ideas about software, AI, and learning as I go.</p>
    </section>
    {notes.length ? <section class="notes-list" aria-labelledby="recent-title">
      <div class="section-top"><h2 id="recent-title">Writing</h2><span>{notes.length} {notes.length === 1 ? 'NOTE' : 'NOTES'}</span></div>
      <ol>
        {notes.map(note => <li>
          <a href={`/${note.slug}`} class="note-link">
            <time datetime={note.data.pubDate.toISOString()}>{formatDate(note.data.pubDate)}</time>
            <span class="note-title">{note.data.title}</span>
            <span class="note-description">{note.data.description}</span>
          </a>
        </li>)}
      </ol>
    </section> : <p class="empty-message">New writing is on the way.</p>}
  </div>
</Layout>
